# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Muse Code's local build log (AGENTS.md, section 6)
.agents/

# Secrets: the real .env and any Streamlit secrets stay local, always
.env
.streamlit/secrets.toml

# NASA C-MAPSS data (CMAPSSData/ at the repo root): commit only the 12 text files the pipeline and the app read
CMAPSSData/*
!CMAPSSData/train_FD00?.txt
!CMAPSSData/test_FD00?.txt
!CMAPSSData/RUL_FD00?.txt

# Trained artifacts: commit only what the app loads, so a clone and the hosted app run without training.
# CNN baselines, *.bak.json and experiments stay local. Re-run precompute after changing a model or the calibration.
artifacts/*
!artifacts/data/
!artifacts/models/
!artifacts/calibration/
!artifacts/precomputed/
artifacts/data/*
!artifacts/data/FD00?.pkl
artifacts/models/*
!artifacts/models/dkl_multitask.pt
!artifacts/models/dkl_FD00?.pt
artifacts/calibration/*
!artifacts/calibration/dkl_multitask.json
!artifacts/calibration/dkl_single.json
artifacts/precomputed/*
!artifacts/precomputed/dkl_multitask.pkl
!artifacts/precomputed/dkl_single.pkl

# Cached Muse Spark responses: committed, so EHA_OFFLINE=1 replays real briefings (temp files stay out)
.cache/*
!.cache/llm/
.cache/llm/*
!.cache/llm/*.json

# Reports: metrics.json, the stage report and the charts at the top level are committed
# (regenerated by `python -m ehagent.evaluate`).
# A comment after a pattern on the same line becomes part of the pattern, so comments stay on their own lines.
reports/*/

# Logs of long runs (log/workdone.md is the build log and is committed)
logs/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
