# Copy to .env and fill in. Never commit the real key.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3

# 1 = never call the API: replay cached responses, otherwise fall back to deterministic templates.
EHA_OFFLINE=0

# Optional: point at another config file (e.g. one that switches model.family to ensemble).
# EHA_CONFIG=configs/default.yaml
